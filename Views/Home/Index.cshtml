@model WeddingInfo
@{
    var groomInitial = string.IsNullOrWhiteSpace(Model.GroomName) ? "?" : Model.GroomName[..1].ToUpperInvariant();
    var brideInitial = string.IsNullOrWhiteSpace(Model.BrideName) ? "?" : Model.BrideName[..1].ToUpperInvariant();
    ViewData["PageTitle"] = $"{Model.GroomName} & {Model.BrideName} — Our Wedding";
    ViewData["Description"] = $"Join {Model.GroomName} and {Model.BrideName} as they celebrate their wedding.";
    ViewData["HeroImage"] = Model.HeroImage;
}
<audio id="weddingMusic" preload="metadata" loop><source src="@Model.MusicPath" type="audio/mpeg" /></audio>
<div class="opening" aria-label="Wedding invitation opening"><div class="opening-bg" aria-hidden="true"></div><div class="opening-curtain curtain-left"><img src="/images/open1.jpeg" alt="" aria-hidden="true" /></div><div class="opening-curtain curtain-right"><img src="/images/open2.jpeg" alt="" aria-hidden="true" /></div><div class="sparkles"></div><div class="floaters" aria-hidden="true"><figure class="floater f1"><img src="/images/4.jpeg" alt=""></figure><figure class="floater f2"><img src="/images/4.jpeg" alt=""></figure><figure class="floater f3"><img src="/images/4.jpeg" alt=""></figure><figure class="floater f4"><img src="/images/4.jpeg" alt=""></figure></div><div class="opening-content"><div class="opening-kicker">Two Hearts</div><div class="opening-journey">One Beautiful Journey</div><div class="opening-names">@Model.GroomName</div><div class="opening-amp">&amp;</div><div class="opening-names">@Model.BrideName</div><div class="opening-date">@Model.WeddingDate.ToString("dd • MM • yyyy")</div><button class="open-button" type="button">OPEN INVITATION <span>→</span></button></div></div>
<nav class="mini-nav" aria-label="Invitation navigation"><a href="#home">Home</a><a href="#story">Story</a><a href="#details">Details</a><a href="#gallery">Gallery</a><a href="#location">Location</a><a href="#closing">Share</a></nav>
<main data-wedding-date="@Model.WeddingDate.ToString("O")">
 <section id="home" class="reference-hero">
  <div class="reference-hero-inner">
   <div class="reference-monogram" role="img" aria-label="@Model.GroomName and @Model.BrideName"><span class="monogram-letter monogram-back">@groomInitial</span><span class="monogram-letter monogram-front">@brideInitial</span></div>
   <div class="reference-flourish" aria-hidden="true"><i></i><b>◆</b><i></i></div>
   <p class="reference-eyebrow">Together with their families</p>
   <div class="reference-names"><div class="reference-name groom-name">@Model.GroomName</div><span class="reference-amp">&amp;</span><div class="reference-name bride-name">@Model.BrideName</div></div>
   <p class="reference-invite">Invite you to join their forever</p>
   <div class="reference-countdown" aria-label="Countdown to the wedding" aria-live="polite"><div><strong data-hero-unit="days">00</strong><span>Days</span></div><b>:</b><div><strong data-hero-unit="hours">00</strong><span>Hours</span></div><b>:</b><div><strong data-hero-unit="minutes">00</strong><span>Minutes</span></div><b>:</b><div><strong data-hero-unit="seconds">00</strong><span>Seconds</span></div></div>
   <p class="reference-date">@Model.WeddingDate.ToString("dd MMMM yyyy").ToUpperInvariant()</p>
   @*الصورتين هوم  *@
      <div class="reference-portraits"><figure>
       <img src="/images/mayarS.jpeg" alt="@Model.GroomName" /></figure>
      <figure><img src="/images/mahmoudS.jpeg" alt="@Model.BrideName" /></figure></div>
  </div>
 </section>
 <section class="calendar-countdown section" aria-labelledby="calendarMonth"><div class="calendar-scene">
    @*التاريخ   *@

    <span class="calendar-spark calendar-spark-a" aria-hidden="true">✦</span><span class="calendar-spark calendar-spark-b" aria-hidden="true">✧</span><span class="calendar-spark calendar-spark-c" aria-hidden="true">✦</span><div class="calendar-clip" aria-hidden="true"><i></i><i></i><i></i></div><div class="calendar-card">
        <aside class="calendar-photo-strip" aria-hidden="true">
            <figure>
                <img src="/images/calendar1.jpeg" alt="" />
            </figure><figure>
                <img src="/images/calendar2.jpeg" alt="" />
            </figure><figure>
                <img src="/images/calendar3.jpeg" alt="" />
            </figure>
        </aside><div class="calendar-sheet"><div class="calendar-sheet-heading"><div><span class="calendar-kicker">Save the date</span><p id="countdownSentence" class="calendar-live" aria-live="polite"></p></div><span class="calendar-heart" aria-hidden="true">♡</span></div><div class="calendar-rule"></div><h2 id="calendarMonth">Wedding Month</h2><div class="calendar-weekdays" aria-hidden="true"><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span></div><div id="weddingCalendar" class="calendar-grid" aria-label="Wedding month calendar"></div><p class="calendar-forever" aria-hidden="true">Our forever begins</p></div>
    </div><span class="calendar-botanical" aria-hidden="true">❦</span>
</div></section>
 <section id="story" class="story section"><div class="eyebrow">A love story</div><h2>THE LITTLE MOMENTS<br />THAT LED US HERE</h2><div class="timeline">@{ var storyImages = new[] { "/images/story1.jpeg", "/images/story2.jpeg", "/images/story3.jpeg", "/images/story4.jpeg" }; } @for (var i = 0; i < Model.StoryItems.Count; i++) { var moment = Model.StoryItems[i]; var imagePath = i < storyImages.Length ? storyImages[i] : string.Empty; <article class="moment"><div class="story-moment-layout"><figure class="story-photo"><img src="@imagePath" loading="lazy" alt="@moment.Title — @Model.GroomName and @Model.BrideName" /></figure><div class="story-moment-copy"><span class="moment-number">0@(i + 1)</span><h3>@moment.Title</h3><p>@moment.Description</p></div></div></article> }</div></section>
 <section id="details" class="details section"><div class="eyebrow">Save the date</div><h2>THE CELEBRATION</h2><div class="detail-grid"><article class="detail"><h3>Ceremony</h3><p>@Model.WeddingDate.ToString("dd MMMM yyyy")<br />@Model.CeremonyTime</p></article><article class="detail"><h3>Reception</h3><p>Let the celebration begin<br />@Model.ReceptionTime</p></article><article class="detail"><h3>Venue</h3><p>@Model.VenueName</p></article><article class="detail"><h3>Address</h3><p>@Model.VenueAddress</p></article></div></section>
 <section id="location" class="location section reference-location"><div class="eyebrow">Where our forever begins</div><h2>@Model.VenueName</h2>
    <p>@Model.VenueAddress</p><div class="location-map"><img src="/images/locationVenue.jpg" alt="Decorative venue map preview" loading="lazy" /><span>OUR CELEBRATION VENUE</span></div><a class="location-button" href="@Model.GoogleMapsUrl" target="_blank" rel="noopener">OPEN IN MAPS <span>↗</span></a></section>
 @*<section id="gallery" class="gallery gallery-album section"><div class="eyebrow">A glimpse of us</div><h2>OUR MOMENTS</h2>
    <div class="gallery-album-row gallery-album-row-top"><div class="gallery-album-frame"><div class="gallery-grid" aria-label="Wedding photo album, first row">@for(var i = 0; i < Model.GalleryImages.Count; i += 2) { <button class="gallery-item" type="button" aria-label="View wedding moment @(i + 1)"><img src="@Model.GalleryImages[i]" loading="lazy" alt="Wedding moment placeholder @(i + 1)" /><span class="gallery-caption" aria-hidden="true">Memory 0@(i + 1)</span></button> }</div></div></div><div class="gallery-album-row gallery-album-row-bottom"><div class="gallery-album-frame"><div class="gallery-grid" aria-label="Wedding photo album, second row">@for(var i = 1; i < Model.GalleryImages.Count; i += 2) { <button class="gallery-item" type="button" aria-label="View wedding moment @(i + 1)"><img src="@Model.GalleryImages[i]" loading="lazy" alt="Wedding moment placeholder @(i + 1)" /><span class="gallery-caption" aria-hidden="true">Memory 0@(i + 1)</span></button> }</div></div></div></section>*@
 
<section id="gallery" class="gallery gallery-album section">
    <div class="eyebrow">A glimpse of us</div>
    <h2>OUR MOMENTS</h2>

    <!-- Top row: Images 1 → 6 -->
    <div class="gallery-album-row gallery-album-row-top">
        <div class="gallery-album-frame">
            <div class="gallery-grid" aria-label="Wedding photo album, first row">
                @for (var i = 0; i < Math.Min(6, Model.GalleryImages.Count); i++)
                {
                <button class="gallery-item" type="button" aria-label="View wedding moment @(i + 1)">
                    <img src="@Model.GalleryImages[i]"
                         loading="lazy"
                         alt="Wedding moment @(i + 1)" />
                    <span class="gallery-caption" aria-hidden="true">
                        Memory 0@(i + 1)
                    </span>
                </button>
                }
            </div>
        </div>
    </div>

    <!-- Bottom row: Images 7 → 12 -->
    <div class="gallery-album-row gallery-album-row-bottom">
        <div class="gallery-album-frame">
            <div class="gallery-grid" aria-label="Wedding photo album, second row">
                @for (var i = 6; i < Model.GalleryImages.Count; i++)
                {
                <button class="gallery-item" type="button" aria-label="View wedding moment @(i + 1)">
                    <img src="@Model.GalleryImages[i]"
                         loading="lazy"
                         alt="Wedding moment @(i + 1)" />
                    <span class="gallery-caption" aria-hidden="true">
                        Memory 0@(i + 1)
                    </span>
                </button>
                }
            </div>
        </div>
    </div>
</section>
    
    <section id="closing" class="closing-invitation section" aria-labelledby="closing-title">
        <div class="closing-card">
            <div class="closing-ornament" aria-hidden="true"><i></i><span>✦</span><i></i></div>
            <p class="closing-kicker">With love, we invite you to celebrate</p>
            <h2 id="closing-title"><span>@Model.GroomName</span><b>&amp;</b><span>@Model.BrideName</span></h2>
            <p class="closing-date">@Model.WeddingDate.ToString("dddd · dd MMMM · yyyy").ToUpperInvariant()</p>
            <div class="closing-ornament closing-ornament-small" aria-hidden="true"><i></i><span>◆</span><i></i></div>
            <blockquote lang="ar" dir="rtl">وَجَعَلَ بَيْنَكُم مَوَدَّةً وَرَحْمَةً</blockquote>
            <p class="closing-translation">“And He placed between you affection and mercy.”</p>
            <p class="closing-source">QUR’AN 30:21</p>
            <div class="closing-ornament closing-ornament-heart" aria-hidden="true"><i></i><span>♥</span><i></i></div>
            <button class="share-invitation" type="button"><span>SHARE THE INVITATION</span><b aria-hidden="true">↗</b></button>
            <p class="share-status" aria-live="polite"></p>
        </div>
    </section>
</main>
<button class="music-player" type="button" aria-label="Play wedding music" aria-pressed="false"><span class="music-bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="music-label">Music</span><span class="music-state">Play</span></button>
<footer class="footer"><p>We can’t wait to celebrate with you.</p><small>@Model.GroomName &amp; @Model.BrideName · @Model.WeddingDate.ToString("dd MMMM yyyy").ToUpperInvariant()</small></footer>
<div class="lightbox" role="dialog" aria-label="Photo preview" aria-modal="true"><button type="button" aria-label="Close photo preview">×</button><img src="" alt="Expanded wedding moment" /></div>
